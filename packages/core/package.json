{
  "name": "notifykit",
  "version": "1.0.0",
  "description": "Enterprise-ready transactional notification delivery engine for Node.js",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "notifykit": "./bin/notifykit.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js",
      "require": "./dist/interfaces/index.cjs"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js",
      "require": "./dist/queue/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "bullmq": "^5.41.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.5.0",
    "notifykit-cli": "^1.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
