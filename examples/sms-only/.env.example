# Redis Connection
REDIS_URL=redis://localhost:6379

# Select SMS Provider: 'twilio' or 'msg91'
SMS_PROVIDER=twilio

# Twilio Credentials (Global SMS)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+15555550100

# MSG91 Credentials (India DLT SMS)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_msg91_flow_id
MSG91_SENDER_ID=NOTIFY

# Target Recipient (Fictitious E.164 phone number)
RECIPIENT_PHONE=+15555550199
